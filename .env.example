# Copia este archivo a `.env` y ajusta los valores. `.env` está ignorado por git.
# Todas las variables son leídas por la aplicación en el arranque; las de la
# sección "Base de datos" también las usa docker-compose para provisionar PostgreSQL.

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bcrp_fx_alerts
DB_SCHEMA=fx_alerts
DB_USER=fx_alerts
DB_PASSWORD=cambia-esta-clave-solo-local
DB_POOL_SIZE=10
