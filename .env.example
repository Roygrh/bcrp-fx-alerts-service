# Copia este archivo a `.env` y ajusta los valores. `.env` está ignorado por git.
# Todas las variables son leídas por la aplicación en el arranque; las de la
# sección "Base de datos" también las usa docker-compose para provisionar PostgreSQL.
# Las duraciones se escriben con unidad: 500ms, 5s, 15m, 24h.

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bcrp_fx_alerts
DB_SCHEMA=fx_alerts
DB_USER=fx_alerts
DB_PASSWORD=cambia-esta-clave-solo-local
DB_POOL_SIZE=10

# --- Seguridad: firma de tokens (OAuth 2.0 client_credentials + JWT RS256) ---
# El servicio firma los tokens con la clave PRIVADA y los verifica con la PÚBLICA. Sin
# JWT_PRIVATE_KEY el servicio NO arranca: nunca genera una clave efímera en silencio.
# NUNCA versiones las claves. Genera el par (PKCS#8 + SubjectPublicKeyInfo, 2048 bits o más) con
# OpenSSL (en Windows, desde Git Bash):
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
#
# Una variable de entorno no conserva saltos de línea: pega el PEM en UNA sola línea con `\n`
# literales y entre comillas simples (para que `source .env` no interprete las barras):
#
#   printf "JWT_PRIVATE_KEY='%s'\n" "$(awk 'NF { printf "%s\\n", $0 }' jwt-private.pem)" >> .env
#   printf "JWT_PUBLIC_KEY='%s'\n"  "$(awk 'NF { printf "%s\\n", $0 }' jwt-public.pem)"  >> .env
#
# Si la clave privada viniera en PKCS#1 (`BEGIN RSA PRIVATE KEY`), conviértela:
#   openssl pkcs8 -topk8 -nocrypt -in antigua.pem -out jwt-private.pem
JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nPEGA-AQUI-LA-CLAVE-EN-UNA-LINEA\n-----END PRIVATE KEY-----\n'
# Opcional: si se indica, debe corresponder a la privada (se comprueba al arrancar); si no, se
# deriva de ella.
# JWT_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n'
# Claims `iss` y `aud` de los tokens; se exigen también al verificarlos.
JWT_ISSUER=bcrp-fx-alerts-service
JWT_AUDIENCE=bcrp-fx-alerts-api
# Vida de cada token (entre 1m y 24h). No hay tokens de refresco: al caducar se pide otro.
JWT_TTL=15m

# --- Seguridad: clientes autorizados ---
# Entradas separadas por `;`, cada una `<client_id>|<hash del secreto>|<alcance,...>`.
#   client_id : [A-Za-z0-9._-], hasta 64 caracteres; es el propietario de sus alertas.
#   hash      : PBKDF2-HMAC-SHA256 del secreto (NUNCA el secreto en claro). Genera secreto y hash:
#                 sbt "runMain pe.quiroz.fxalerts.infrastructure.security.ClientSecretTool"
#               o el hash de un secreto ya existente:
#                 CLIENT_SECRET='...' sbt "runMain pe.quiroz.fxalerts.infrastructure.security.ClientSecretTool"
#   alcances  : alerts:read, alerts:write, rates:read (separados por comas).
# El hash solo contiene [A-Za-z0-9:_-], por lo que no necesita comillas.
OAUTH_CLIENTS=cliente-001|pbkdf2-sha256:600000:REEMPLAZA-SAL:REEMPLAZA-HASH|alerts:read,alerts:write,rates:read;monitor-001|pbkdf2-sha256:600000:REEMPLAZA-SAL:REEMPLAZA-HASH|rates:read

# --- Fuentes de tipo de cambio ---
# Orden de consulta, separado por comas. La primera es la principal; las siguientes solo se usan
# cuando la anterior NO PUDO responder. Códigos admitidos:
#   BCRP  -> BCRPData, serie PD04640PD (TC venta SBS). Fuente OFICIAL.
#   ERAPI -> ExchangeRate-API (open.er-api.com). Tasa de mercado indicativa, NO oficial.
# "BCRP" a secas desactiva el respaldo; "ERAPI,BCRP" invierte la prioridad.
RATE_SOURCES=BCRP,ERAPI

# --- Cliente BCRP (fuente oficial) ---
# Raíz de la API; los segmentos /{serie}/json/{inicio}/{fin}/esp se añaden por petición.
BCRP_BASE_URL=https://estadisticas.bcrp.gob.pe/estadisticas/series/api
# Tiempo máximo para conectar y para recibir la respuesta (el presupuesto por intento es la suma).
BCRP_CONNECT_TIMEOUT=3s
BCRP_READ_TIMEOUT=5s
# Reintentos adicionales al primer intento, solo ante fallos transitorios (timeout, conexión, 5xx).
BCRP_MAX_RETRIES=2
# Espera antes del primer reintento; se duplica en cada reintento posterior.
BCRP_RETRY_BACKOFF=500ms
# Días hacia atrás que abarca la ventana consultada (debe cubrir un fin de semana largo).
BCRP_LOOKBACK_DAYS=7

# --- Cliente ExchangeRate-API (fuente de respaldo, no oficial) ---
# Raíz de la API de acceso abierto; el recurso /latest/USD se añade por petición.
ERAPI_BASE_URL=https://open.er-api.com/v6
ERAPI_CONNECT_TIMEOUT=3s
ERAPI_READ_TIMEOUT=5s
ERAPI_MAX_RETRIES=2
ERAPI_RETRY_BACKOFF=500ms

# --- Caché en memoria del tipo de cambio (común a todas las fuentes) ---
# Periodo durante el cual el dato se sirve sin reconsultar a las fuentes (FRESH).
BCRP_CACHE_TTL=15m
# Antigüedad máxima con la que se sirve un dato obsoleto (STALE) si ninguna fuente responde. >= TTL.
BCRP_CACHE_MAX_STALE=24h
# Tras un fallo de todas las fuentes, tiempo durante el que se sirve el dato obsoleto (o se repite
# el fallo si no hay ninguno) sin volver a intentarlo.
BCRP_CACHE_FAILURE_BACKOFF=1m
